APP_NAME=Laravel
APP_ENV=local
# Note: The installer will automatically generate a new secure key for you.
# This placeholder key is only to allow the application to boot for the installer.
APP_KEY=base64:PlceHolderKeyForInstallerToBoot123456789012=
APP_DEBUG=true
APP_URL=http://localhost:8000

INSURIVAULT_API_URL=https://client-api-dev.insuri-vault.com
INSURIVAULT_ORGANIZATION="Demo Organization"
INSURIVAULT_ORIGIN_HOST=

# How this organization is named to the people signing in: the navigation bar, the browser tab, and
# the message telling a client who to contact when sign-in fails. Presentation only — it is never
# sent to the API, and is deliberately separate from INSURIVAULT_ORGANIZATION above, which is the
# name InsuriVault resolves the tenant by and must keep matching the master account.
# Unset, the portal names itself InsuriVault.
ORGANIZATION_DISPLAY_NAME="Demo Organization"

# Whether the portal is light or dark. This is the base every other setting sits on top of: a
# colour scheme tints it, and the individual colours below are written last and win over both.
# Leave it empty or write light for the portal as it ships. An unrecognised name is ignored.
# Available: light, dark
PORTAL_BASE_THEME=

# A hue laid over the base. The surfaces keep the base's weight and take the scheme's colour, so
# the same name reads differently on each: green over light is a pale green portal, green over
# dark is a deep one. An unrecognised name leaves the base untinted.
# Available: blue, green, purple
PORTAL_COLOR_SCHEME=

# The portal's colours. Each is a hex value or a standard Tailwind colour name (slate-900,
# indigo-700, rose-500, black, white). Anything else is ignored and the default below is used, so a
# typo leaves the portal looking as it shipped rather than breaking the page.
#
# QUOTE A HEX VALUE, or write it without the hash: in this file an unquoted # starts a comment, so
#   PORTAL_ACCENT_COLOR=#4338ca    is read as an empty value and silently does nothing
#   PORTAL_ACCENT_COLOR="#4338ca"  works
#   PORTAL_ACCENT_COLOR=4338ca     works
#
# Set the two navigation colours together — a pale bar with pale text is unreadable, and the portal
# will not correct your choice. README_SERVER_INSTALL.md has the full list of colour names.
#
# The navigation bar's background. Default: slate-900
PORTAL_NAVIGATION_BACKGROUND_COLOR=
# The navigation bar's text. Default: slate-50
PORTAL_NAVIGATION_TEXT_COLOR=
# The login header band, the Login button, links and focus outlines. Default: sky-700
PORTAL_ACCENT_COLOR=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
